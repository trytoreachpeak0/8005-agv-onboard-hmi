<Window x:Class="SQCD.Agv.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQCD.Agv.Wpf.ViewModels"
        Title="8005 多仓位AGV车载端"
        Width="1000"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        Background="{StaticResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="车辆" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="{Binding AgvId}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AgvId}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="任务系统" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding RuleConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="仓门控制" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding IoConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="上层会话" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding WireToGateText}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <!--
                    旅程事实（批次6-03）：本站取货还是卸货、清单项的任务类型，与「到站」同一行，不撑高顶栏。
                    方向只随服务端的 stopRole／legType，任务类型只随清单项的 workType，都不推断；无清单项时任务类型为空。
                    站点功能名与服务端的投运阻断原因都不上界面（规格第 5.3 节）。UIA 按 AutomationId 找这两个元素。
                    -->
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="到站" />
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="8,0,0,0"
                                   AutomationProperties.AutomationId="StopDirection"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Text="{Binding StopDirectionText}" />
                        <TextBlock Margin="8,0,0,0"
                                   AutomationProperties.AutomationId="TaskType"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding TaskTypeText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TaskTypeText}" />
                    </DockPanel>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding VisitText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding VisitText}" />
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="发车安全" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="{Binding DepartureText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DepartureText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="物料条码" />
                <TextBox x:Name="ScanTextBox"
                         Grid.Column="1"
                         Height="38"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="18"
                         IsEnabled="{Binding CanSubmit}"
                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScannerSubmitCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Command="{Binding ManualSubmitCommand}"
                        Content="手动提交" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" CornerRadius="8" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="BorderBrush" Value="#9ABCEB" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Background" Value="#FFF8E7" />
                            <Setter Property="BorderBrush" Value="#E5B75B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FFF0F0" />
                            <Setter Property="BorderBrush" Value="#E89B9B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding StateText}" />
                <!--
                    离站期限倒计时（ADR-cross-0055，8005-agv-onboard-hmi#75）。放在提示区状态行的右端：它是操作员在车前
                    决定该等还是该取消的那个数字。期限只来自服务端快照，车载端只显示。三档配色靠 Tier，最后 10 秒的
                    逐秒闪烁靠 Dimmed。UIA 按 AutomationId 找它，ItemStatus 给档位，判据不必比文案全文。
                    容器宽高固定：五个档位字号不同（20／15），文字从「00:45」到「已到期，等待本站结束」长短不一。
                    Column 2 是 Auto，若随内容伸缩，切档时会挤动左边的提示文案、撑高这一行。200 放得下最长的一条，#78 的
                    「已到期，正在取消本站装货」（15px 粗体量得 180 px，180 的宽度会被 DPI 取整挤出省略号）；46 低于提示文案
                    ScrollViewer 的 MaxHeight 48。#78 期限过后在途装货的整句「请放入货物并关闭 N 号仓门；不装了请按取消」
                    在提示文案那一行（会换行），这里只随时钟显示「已过期 mm:ss」。
                -->
                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Width="200"
                            Height="46"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasStationDepartureCountdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Height="16"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="离站剩余" />
                    <Grid Height="28" Margin="0,2,0,0">
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="StationDepartureCountdown"
                                   AutomationProperties.ItemStatus="{Binding StationDepartureCountdownTier}"
                                   Text="{Binding StationDepartureCountdownText}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <!-- 字号与字重放在 Setter 里而不是元素属性上：本地值优先于触发器，写在元素上两个文字档就改不小。 -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#1F2933" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Absent">
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Warning">
                                            <Setter Property="Foreground" Value="#C08A00" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Critical">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Expired">
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownDimmed}" Value="True">
                                            <Setter Property="Opacity" Value="0.15" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="0"
                              Grid.Column="1"
                              MaxHeight="48"
                              Margin="12,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Text="{Binding Guidance}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{Binding AlarmText, StringFormat=告警：{0}}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasAlarms, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!--
                    期待动作超时（REQ-0358，8005-agv-onboard-hmi#109）。当前仓自第一次开锁起等太久时出现：会话在线说已上报、
                    班组长或管理员会到现场查看，断开时只说与服务端断开、请联系管理员。只是告知，这一行旁边没有任何按钮——
                    判故障在服务端，操作工的界面上不设入口。没有时整行 Collapsed。UIA 按 AutomationId 找它。
                -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#8A5A00"
                           AutomationProperties.AutomationId="ExpectedActionOverdue"
                           Text="{Binding ExpectedActionOverdueText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasExpectedActionOverdue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!--
                    子批拒收原因（ADR-cross-0057，8005-agv-onboard-hmi#77）。服务端录入后重算不符时经 SublotRejected 拒收，
                    这一行写被拒的子批和真实原因；下一步做什么在状态行。放在提示区、不进仓位区。没有拒收时整行 Collapsed，
                    Auto 行高为 0，不改变其余布局。UIA 按 AutomationId 找它，ItemStatus 是原始原因码，判据不必比文案全文。
                -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#8A5A00"
                           AutomationProperties.AutomationId="SublotRejectionReason"
                           AutomationProperties.ItemStatus="{Binding SublotRejectionReasonCode}"
                           Text="{Binding SublotRejectionText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSublotRejection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!--
                    强制机械取出之后物理状态未知的仓位（REQ-0241，8005-agv-onboard-hmi#107）。这些仓在提交硬件恢复记录前
                    禁止任何仓位操作；没有时整行 Collapsed。UIA 按 AutomationId 找它。
                -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           AutomationProperties.AutomationId="PhysicallyUnknownSlots"
                           Text="{Binding PhysicallyUnknownSlotsText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasPhysicallyUnknownSlots, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <WrapPanel Grid.Row="5"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right">
                    <!--
                        异常处置会话的原因（CP-0005 第五节，8005-agv-onboard-hmi#109）：判定人、故障类别、现场说明，写进
                        ExceptionRecoverySessionRequested.reason。只跟着会开会话的四个管理员入口出现（申请恢复、补偿清空、
                        故障交接、强制机械恢复）；留空时按该动作的缺省文字发。
                    -->
                    <TextBlock Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Text="原因（判定人、故障类别、现场说明）"
                               Visibility="{Binding HasRecoveryReasonInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Width="280"
                             Margin="0,0,8,0"
                             Padding="4"
                             FontSize="13"
                             MaxLength="500"
                             VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="RecoveryReason"
                             AutomationProperties.Name="异常处置原因"
                             IsEnabled="{Binding IsRecoveryReasonEditable}"
                             Text="{Binding RecoveryReason, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasRecoveryReasonInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!-- 会话已开时发出去的是开会话时那句原因，框锁住并说明，免得白填。 -->
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               AutomationProperties.AutomationId="RecoveryReasonCarriedOver"
                               Text="会话已开，原因沿用开会话时填写的"
                               Visibility="{Binding HasRecoveryReasonCarriedOver, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestWireToGateRecovery}"
                            Visibility="{Binding CanRequestWireToGateRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnWireToGateRecoveryClick"
                            Content="申请恢复" />
                    <!--
                        多条清单项时扫码前取消由操作员在清单里选需求（批次7-14，8005-agv-onboard-hmi#135）：入口照常出现，
                        没选中时禁用并在旁边说要先选，取代批次7-13 那个「暂不可用」的占位按钮。
                    -->
                    <Button Margin="0,0,4,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanPressLoadCancellation}"
                            Visibility="{Binding CanRequestLoadCancellation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCancellationClick"
                            Content="取消装货" />
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               AutomationProperties.AutomationId="LoadCancellationSelection"
                               Text="{Binding LoadCancellationSelectionHintText}"
                               Visibility="{Binding HasLoadCancellationSelectionHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCompensation}"
                            Visibility="{Binding CanRequestLoadCompensation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCompensationClick"
                            Content="补偿清空" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCorrection}"
                            Visibility="{Binding CanRequestLoadCorrection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCorrectionClick"
                            Content="修正装货" />
                    <!-- 修正装货针对本站最后一次装货；多条清单项时标出是哪一个子批（批次7-13）。 -->
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               AutomationProperties.AutomationId="LoadCorrectionTarget"
                               Text="{Binding LoadCorrectionTargetText}"
                               Visibility="{Binding CanRequestLoadCorrection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestFaultCargoHandoff}"
                            Visibility="{Binding CanRequestFaultCargoHandoff, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnFaultCargoHandoffClick"
                            Content="故障交接" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestForcedMechanicalRecovery}"
                            Visibility="{Binding CanRequestForcedMechanicalRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnForcedMechanicalRecoveryClick"
                            Content="强制机械恢复" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanConfirmForcedMechanicalRecovery}"
                            Visibility="{Binding CanConfirmForcedMechanicalRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnConfirmForcedMechanicalRecoveryClick"
                            Content="已隔离并完成机械取出" />
                    <TextBox Width="240"
                             Margin="0,0,8,0"
                             Padding="4"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="HardwareRecoveryObservations"
                             AutomationProperties.Name="硬件恢复说明"
                             Text="{Binding HardwareRecoveryObservations, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding CanSubmitHardwareRecoveryRecord, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanSubmitHardwareRecoveryRecord}"
                            Visibility="{Binding CanSubmitHardwareRecoveryRecord, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnSubmitHardwareRecoveryRecordClick"
                            Content="提交硬件恢复记录" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanRequestManualChargingReturn}"
                            Visibility="{Binding CanRequestManualChargingReturn, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnManualChargingReturnClick"
                            Content="充电后返回服务" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanRetryPendingResult}"
                            Visibility="{Binding CanRetryPendingResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnRetryPendingResultClick"
                            Content="重新上报结果" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanReopenOperation}"
                            Visibility="{Binding CanReopenOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnReopenOperationClick"
                            Content="重新打开仓门" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="{StaticResource DangerBrush}"
                            IsEnabled="{Binding CanCancelOperation}"
                            Visibility="{Binding CanCancelOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnCancelOperationClick"
                            Content="取消本次操作" />
                    <Button Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanSafetyReview}"
                            Visibility="{Binding CanSafetyReview, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnSafetyReviewClick"
                            Content="启动安全复核" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--
                本站清单与行程计划（批次7-13，8005-agv-onboard-hmi#134）。一站最多 8 条需求、计划最多 9 条腿，所以都是列表：
                清单行序等于服务端 items[] 的顺序，本地不排序；计划按 sequence 排，本地不重排，修订号前进时整表替换。
                清单项的侧只来自带该需求的仓位命令，命令到之前写「待分配」。持货等单、装满与装货结束原因各一行，只显示
                服务端 loadingPhase 的整值：期限不推算，过期只写「已到期，等待服务端」，下一份快照不再是那个状态就消失。
                持货期限与提示区的离站期限是两个期限，各在各的那一行，不合成一个（REQ-0355）。
                UIA 按 AutomationId 找它们，ItemStatus 给原始值，判据不必比中文全文。
            -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" Background="White" CornerRadius="8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#8A5A00"
                                   AutomationProperties.AutomationId="CargoHoldingCountdown"
                                   AutomationProperties.ItemStatus="{Binding CargoHoldingCountdownStatus}"
                                   Text="{Binding CargoHoldingCountdownText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasCargoHoldingCountdown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   AutomationProperties.AutomationId="VehicleFullNotice"
                                   Text="{Binding VehicleFullNoticeText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasVehicleFullNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#8A5A00"
                                   AutomationProperties.AutomationId="LoadingClosedReason"
                                   AutomationProperties.ItemStatus="{Binding LoadingClosedReasonCode}"
                                   Text="{Binding LoadingClosedReasonText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasLoadingClosedReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#334155" Text="本站清单" />
                        <!--
                            可选中（批次7-14）：扫码前取消要取消哪条需求由操作员在这里点，本票只用于取消，
                            不是从清单挑待装任务的入口（WORKLIST_SELECTION 归批次 11）。
                        -->
                        <ListBox Margin="0,2,0,8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.AutomationId="WorklistItems"
                                 ItemsSource="{Binding WorklistItems}"
                                 SelectedItem="{Binding SelectedWorklistItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WorklistItemRow}">
                                    <Border Margin="0,2" Padding="6,4" Background="#F4F7FB" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="14"
                                                           FontWeight="Bold"
                                                           Text="{Binding Sublot}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Sublot}" />
                                                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding DirectionText, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding TaskTypeText, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding ExpectedBasketCountText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       AutomationProperties.AutomationId="WorklistItemSide"
                                                       AutomationProperties.ItemStatus="{Binding SideCode}"
                                                       Text="{Binding SideText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#334155" Text="行程计划" />
                        <ItemsControl Margin="0,2,0,0"
                                      AutomationProperties.AutomationId="JourneyPlanLegs"
                                      ItemsSource="{Binding JourneyPlanLegs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:JourneyPlanLegRow}">
                                    <Grid Margin="0,1" AutomationProperties.ItemStatus="{Binding ItemStatus}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding SequenceText}" />
                                        <TextBlock Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run FontWeight="SemiBold" Text="{Binding StationId, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding StopPurposeText, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding LegTypeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding StateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <DataTemplate DataType="{x:Type vm:LockerCardViewModel}">
                        <Border MinHeight="92" Margin="4" Padding="8" Background="White" CornerRadius="8" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#D9E1EA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Background" Value="#F0F6FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Background" Value="#FFF5F5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" Text="{Binding DoorText}" />
                                <TextBlock Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding CargoText}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding TargetText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ScrollViewer.Resources>
                <StackPanel MinHeight="200">
                    <TextBlock Margin="4,0,4,2"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding OpeningSideText}"
                               Visibility="{Binding HasOpeningSide, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding SlotGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlotGroupViewModel}">
                                <StackPanel Margin="0,2,0,2">
                                    <Border Margin="4,2,4,0" Padding="8,2" HorizontalAlignment="Left" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#334155" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnknownSide}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Lockers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" Padding="8" Background="#17212E" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="2,0,0,4" Foreground="White" FontSize="13" FontWeight="Bold" Text="操作记录（最近300条）" />
                    <Button Grid.Column="1"
                            Padding="10,3"
                            FontSize="12"
                            Command="{Binding ClearLogsCommand}"
                            Content="清空界面记录" />
                </Grid>
                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="12"
                         Foreground="#D8E2EE"
                         ItemsSource="{Binding Logs}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top"
                                           Foreground="#90A2B6"
                                           Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Top"
                                           FontWeight="Bold"
                                           Text="{Binding CategoryText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B8C6D5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Operation">
                                                    <Setter Property="Foreground" Value="#79B8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="#66D692" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FFD166" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="#FF7B7B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Top"
                                           Foreground="#E7EDF4"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
