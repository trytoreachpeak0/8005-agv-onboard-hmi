<Window x:Class="SQCD.Agv.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQCD.Agv.Wpf.ViewModels"
        Title="8005 多仓位AGV车载端"
        Width="1000"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        Background="{StaticResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="车辆" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="{Binding AgvId}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AgvId}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="任务系统" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding RuleConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="仓门控制" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding IoConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="上层会话" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding WireToGateText}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="到站" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding VisitText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding VisitText}" />
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="发车安全" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="{Binding DepartureText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DepartureText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="物料条码" />
                <TextBox x:Name="ScanTextBox"
                         Grid.Column="1"
                         Height="38"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="18"
                         IsEnabled="{Binding CanSubmit}"
                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScannerSubmitCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Command="{Binding ManualSubmitCommand}"
                        Content="手动提交" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" CornerRadius="8" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="BorderBrush" Value="#9ABCEB" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Background" Value="#FFF8E7" />
                            <Setter Property="BorderBrush" Value="#E5B75B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FFF0F0" />
                            <Setter Property="BorderBrush" Value="#E89B9B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding StateText}" />
                <ScrollViewer Grid.Row="0"
                              Grid.Column="1"
                              MaxHeight="48"
                              Margin="12,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Text="{Binding Guidance}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{Binding AlarmText, StringFormat=告警：{0}}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasAlarms, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <WrapPanel Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestWireToGateRecovery}"
                            Visibility="{Binding CanRequestWireToGateRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnWireToGateRecoveryClick"
                            Content="申请恢复" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCancellation}"
                            Visibility="{Binding CanRequestLoadCancellation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCancellationClick"
                            Content="取消装货" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCompensation}"
                            Visibility="{Binding CanRequestLoadCompensation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCompensationClick"
                            Content="补偿清空" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCorrection}"
                            Visibility="{Binding CanRequestLoadCorrection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCorrectionClick"
                            Content="修正装货" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestFaultCargoHandoff}"
                            Visibility="{Binding CanRequestFaultCargoHandoff, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnFaultCargoHandoffClick"
                            Content="故障交接" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanRetryPendingResult}"
                            Visibility="{Binding CanRetryPendingResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnRetryPendingResultClick"
                            Content="重新上报结果" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanReopenOperation}"
                            Visibility="{Binding CanReopenOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnReopenOperationClick"
                            Content="重新打开仓门" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="{StaticResource DangerBrush}"
                            IsEnabled="{Binding CanCancelOperation}"
                            Visibility="{Binding CanCancelOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnCancelOperationClick"
                            Content="取消本次操作" />
                    <Button Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanSafetyReview}"
                            Visibility="{Binding CanSafetyReview, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnSafetyReviewClick"
                            Content="启动安全复核" />
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3"
                      Margin="0,6"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl MinHeight="200" ItemsSource="{Binding Lockers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LockerCardViewModel}">
                        <Border MinHeight="92" Margin="4" Padding="8" Background="White" CornerRadius="8" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#D9E1EA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Background" Value="#F0F6FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Background" Value="#FFF5F5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" Text="{Binding DoorText}" />
                                <TextBlock Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding CargoText}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding TargetText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="8" Background="#17212E" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="2,0,0,4" Foreground="White" FontSize="13" FontWeight="Bold" Text="操作记录（最近300条）" />
                    <Button Grid.Column="1"
                            Padding="10,3"
                            FontSize="12"
                            Command="{Binding ClearLogsCommand}"
                            Content="清空界面记录" />
                </Grid>
                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="12"
                         Foreground="#D8E2EE"
                         ItemsSource="{Binding Logs}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top"
                                           Foreground="#90A2B6"
                                           Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Top"
                                           FontWeight="Bold"
                                           Text="{Binding CategoryText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B8C6D5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Operation">
                                                    <Setter Property="Foreground" Value="#79B8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="#66D692" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FFD166" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="#FF7B7B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Top"
                                           Foreground="#E7EDF4"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
