<Window x:Class="SQCD.Agv.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQCD.Agv.Wpf.ViewModels"
        Title="8005 多仓位AGV车载端"
        Width="1000"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        Background="{StaticResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="车辆" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="{Binding AgvId}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AgvId}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="任务系统" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding RuleConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="仓门控制" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding IoConnectionText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="上层会话" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding WireToGateText}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="到站" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding VisitText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding VisitText}" />
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="发车安全" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="{Binding DepartureText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DepartureText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="物料条码" />
                <TextBox x:Name="ScanTextBox"
                         Grid.Column="1"
                         Height="38"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="18"
                         IsEnabled="{Binding CanSubmit}"
                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScannerSubmitCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Command="{Binding ManualSubmitCommand}"
                        Content="手动提交" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" CornerRadius="8" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="BorderBrush" Value="#9ABCEB" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Background" Value="#FFF8E7" />
                            <Setter Property="BorderBrush" Value="#E5B75B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FFF0F0" />
                            <Setter Property="BorderBrush" Value="#E89B9B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding StateText}" />
                <!--
                    离站期限倒计时（ADR-cross-0055，8005-agv-onboard-hmi#75）。放在提示区状态行的右端：它是操作员在车前
                    决定该等还是该取消的那个数字。期限只来自服务端快照，车载端只显示。三档配色靠 Tier，最后 10 秒的
                    逐秒闪烁靠 Dimmed。UIA 按 AutomationId 找它，ItemStatus 给档位，判据不必比文案全文。
                    容器宽高固定：五个档位字号不同（20／15），文字从「00:45」到「已到期，等待本站结束」长短不一。
                    Column 2 是 Auto，若随内容伸缩，切档时会挤动左边的提示文案、撑高这一行。180 放得下最长的通用文案；
                    46 低于提示文案 ScrollViewer 的 MaxHeight 48。更长的覆盖文案（#78）按字符省略。
                -->
                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Width="180"
                            Height="46"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasStationDepartureCountdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Height="16"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="离站剩余" />
                    <Grid Height="28" Margin="0,2,0,0">
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="StationDepartureCountdown"
                                   AutomationProperties.ItemStatus="{Binding StationDepartureCountdownTier}"
                                   Text="{Binding StationDepartureCountdownText}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <!-- 字号与字重放在 Setter 里而不是元素属性上：本地值优先于触发器，写在元素上两个文字档就改不小。 -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#1F2933" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Absent">
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Warning">
                                            <Setter Property="Foreground" Value="#C08A00" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Critical">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownTier}" Value="Expired">
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StationDepartureCountdownDimmed}" Value="True">
                                            <Setter Property="Opacity" Value="0.15" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="0"
                              Grid.Column="1"
                              MaxHeight="48"
                              Margin="12,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Text="{Binding Guidance}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{Binding AlarmText, StringFormat=告警：{0}}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasAlarms, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <WrapPanel Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestWireToGateRecovery}"
                            Visibility="{Binding CanRequestWireToGateRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnWireToGateRecoveryClick"
                            Content="申请恢复" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCancellation}"
                            Visibility="{Binding CanRequestLoadCancellation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCancellationClick"
                            Content="取消装货" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCompensation}"
                            Visibility="{Binding CanRequestLoadCompensation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCompensationClick"
                            Content="补偿清空" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestLoadCorrection}"
                            Visibility="{Binding CanRequestLoadCorrection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnLoadCorrectionClick"
                            Content="修正装货" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestFaultCargoHandoff}"
                            Visibility="{Binding CanRequestFaultCargoHandoff, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnFaultCargoHandoffClick"
                            Content="故障交接" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="#D6A32A"
                            IsEnabled="{Binding CanRequestForcedMechanicalRecovery}"
                            Visibility="{Binding CanRequestForcedMechanicalRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnForcedMechanicalRecoveryClick"
                            Content="强制机械恢复" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanRequestManualChargingReturn}"
                            Visibility="{Binding CanRequestManualChargingReturn, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnManualChargingReturnClick"
                            Content="充电后返回服务" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanRetryPendingResult}"
                            Visibility="{Binding CanRetryPendingResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnRetryPendingResultClick"
                            Content="重新上报结果" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanReopenOperation}"
                            Visibility="{Binding CanReopenOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnReopenOperationClick"
                            Content="重新打开仓门" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="{StaticResource DangerBrush}"
                            IsEnabled="{Binding CanCancelOperation}"
                            Visibility="{Binding CanCancelOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnCancelOperationClick"
                            Content="取消本次操作" />
                    <Button Padding="12,6"
                            FontSize="13"
                            IsEnabled="{Binding CanSafetyReview}"
                            Visibility="{Binding CanSafetyReview, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OnSafetyReviewClick"
                            Content="启动安全复核" />
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3"
                      Margin="0,6"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <DataTemplate DataType="{x:Type vm:LockerCardViewModel}">
                    <Border MinHeight="92" Margin="4" Padding="8" Background="White" CornerRadius="8" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#D9E1EA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Background" Value="#F0F6FF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Background" Value="#FFF5F5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
                            <TextBlock Margin="0,4,0,0" FontSize="14" Text="{Binding DoorText}" />
                            <TextBlock Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding CargoText}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding TargetText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ScrollViewer.Resources>
            <StackPanel MinHeight="200">
                <TextBlock Margin="4,0,4,2"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="{Binding OpeningSideText}"
                           Visibility="{Binding HasOpeningSide, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding SlotGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SlotGroupViewModel}">
                            <StackPanel Margin="0,2,0,2">
                                <Border Margin="4,2,4,0" Padding="8,2" HorizontalAlignment="Left" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#334155" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnknownSide}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Lockers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="8" Background="#17212E" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="2,0,0,4" Foreground="White" FontSize="13" FontWeight="Bold" Text="操作记录（最近300条）" />
                    <Button Grid.Column="1"
                            Padding="10,3"
                            FontSize="12"
                            Command="{Binding ClearLogsCommand}"
                            Content="清空界面记录" />
                </Grid>
                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="12"
                         Foreground="#D8E2EE"
                         ItemsSource="{Binding Logs}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top"
                                           Foreground="#90A2B6"
                                           Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Top"
                                           FontWeight="Bold"
                                           Text="{Binding CategoryText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B8C6D5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Operation">
                                                    <Setter Property="Foreground" Value="#79B8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="#66D692" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FFD166" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="#FF7B7B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Top"
                                           Foreground="#E7EDF4"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
