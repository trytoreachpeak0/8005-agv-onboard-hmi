{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/wire-to-gate/v1/messages/SessionHello.schema.json",
  "title": "SessionHello",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 3
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "WIRE_TO_GATE_MVP"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "0.1.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "SessionHello"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "type": "null"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "onboardInstanceId": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
        },
        "onboardBuildCommit": {
          "type": "string",
          "minLength": 1
        },
        "supportedProtocolVersion": {
          "type": "integer",
          "const": 3
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "const": "WIRE_TO_GATE_MVP"
        },
        "protocolReleaseIdentity": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/ProtocolReleaseIdentity"
        },
        "credentialProof": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "INVALID-PLACEHOLDER-NOT-A-SECRET"
          ]
        }
      },
      "required": [
        "onboardInstanceId",
        "onboardBuildCommit",
        "supportedProtocolVersion",
        "profileId",
        "protocolReleaseIdentity",
        "credentialProof"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
