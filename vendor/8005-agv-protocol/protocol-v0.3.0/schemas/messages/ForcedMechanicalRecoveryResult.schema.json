{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/wire-to-gate/v1/messages/ForcedMechanicalRecoveryResult.schema.json",
  "title": "ForcedMechanicalRecoveryResult",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 3
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "WIRE_TO_GATE_MVP"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "0.1.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "ForcedMechanicalRecoveryResult"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "exceptionRecoverySessionId": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
        },
        "recoveryActionId": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
        },
        "forcedRecoveryGeneration": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Generation"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "MECHANICALLY_ISOLATED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/SlotNo"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "x-sortedAscending": true
        },
        "operator": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/OperatorContext"
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
        },
        "electronicEmptyProven": {
          "type": "boolean",
          "const": false
        },
        "vehicleReadyProven": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "exceptionRecoverySessionId",
        "recoveryActionId",
        "forcedRecoveryGeneration",
        "outcome",
        "slots",
        "operator",
        "observedAt",
        "electronicEmptyProven",
        "vehicleReadyProven"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
