{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/wire-to-gate/v1/envelope.schema.json",
  "title": "ProtocolEnvelope",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 3
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "WIRE_TO_GATE_MVP"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "0.1.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "anyOf": [
        {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "anyOf": [
        {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Generation"
        },
        {
          "type": "null"
        }
      ]
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
