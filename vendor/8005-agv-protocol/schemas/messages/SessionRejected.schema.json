{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v4/messages/SessionRejected.schema.json",
  "title": "SessionRejected",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 4
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "3.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "SessionRejected"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "type": "null"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "problem": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Problem"
        },
        "expectedProtocolVersion": {
          "type": "integer",
          "const": 4
        },
        "expectedProtocolReleaseIdentity": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/ProtocolReleaseIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "problem",
        "expectedProtocolVersion",
        "expectedProtocolReleaseIdentity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
