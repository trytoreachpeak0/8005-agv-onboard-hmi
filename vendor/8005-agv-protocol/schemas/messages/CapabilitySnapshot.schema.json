{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v2/messages/CapabilitySnapshot.schema.json",
  "title": "CapabilitySnapshot",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 2
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "1.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "CapabilitySnapshot"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "capabilityVersion": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Revision"
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
        },
        "slotModelVersion": {
          "type": "string",
          "minLength": 1
        },
        "activeSlotConfigurationVersion": {
          "type": "string",
          "minLength": 1
        },
        "activeSlotConfigurationFingerprint": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Sha256"
        },
        "slotStates": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/SlotState"
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "supportsBatchUnlock": {
          "type": "boolean"
        },
        "onboardJournalFormatVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "capabilityVersion",
        "observedAt",
        "slotModelVersion",
        "activeSlotConfigurationVersion",
        "activeSlotConfigurationFingerprint",
        "slotStates",
        "supportsBatchUnlock",
        "onboardJournalFormatVersion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
