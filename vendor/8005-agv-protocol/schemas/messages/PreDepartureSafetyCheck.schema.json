{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v4/messages/PreDepartureSafetyCheck.schema.json",
  "title": "PreDepartureSafetyCheck",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 4
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "3.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "PreDepartureSafetyCheck"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "preDepartureSafetyCheckId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "checkPurpose": {
          "type": "string",
          "enum": [
            "DEPARTURE",
            "NON_BUSINESS_MOVE",
            "HOLD_RELEASE"
          ]
        },
        "demandId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "movementLegId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedSafetyStateVersion": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Revision"
        },
        "targetStationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "preDepartureSafetyCheckId",
        "checkPurpose",
        "demandId",
        "movementLegId",
        "expectedSafetyStateVersion",
        "targetStationId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "checkPurpose": {
                "const": "DEPARTURE"
              }
            },
            "required": [
              "checkPurpose"
            ]
          },
          "then": {
            "properties": {
              "demandId": {
                "type": "string"
              },
              "movementLegId": {
                "type": "string"
              },
              "targetStationId": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checkPurpose": {
                "const": "NON_BUSINESS_MOVE"
              }
            },
            "required": [
              "checkPurpose"
            ]
          },
          "then": {
            "properties": {
              "demandId": {
                "type": "null"
              },
              "movementLegId": {
                "type": "string"
              },
              "targetStationId": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checkPurpose": {
                "const": "HOLD_RELEASE"
              }
            },
            "required": [
              "checkPurpose"
            ]
          },
          "then": {
            "properties": {
              "demandId": {
                "type": "null"
              },
              "movementLegId": {
                "type": "null"
              },
              "targetStationId": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
