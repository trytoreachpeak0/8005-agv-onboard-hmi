{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v4/messages/SlotFaultDeclarationCommand.schema.json",
  "title": "SlotFaultDeclarationCommand",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 4
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "3.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "SlotFaultDeclarationCommand"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "declarationId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "demandId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "slotOperationAttemptId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "slotNo": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/SlotNo"
        },
        "administrator": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/OperatorContext"
        },
        "administratorRole": {
          "type": "string",
          "enum": [
            "MAINTENANCE_ADMINISTRATOR",
            "SYSTEM_ADMINISTRATOR"
          ]
        },
        "faultCategory": {
          "type": "string",
          "enum": [
            "LOCK",
            "LIGHT_CURTAIN",
            "DOOR_MECHANISM",
            "IO_MODULE"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "declaredAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
        }
      },
      "required": [
        "declarationId",
        "demandId",
        "slotOperationAttemptId",
        "slotNo",
        "administrator",
        "administratorRole",
        "faultCategory",
        "note",
        "declaredAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
