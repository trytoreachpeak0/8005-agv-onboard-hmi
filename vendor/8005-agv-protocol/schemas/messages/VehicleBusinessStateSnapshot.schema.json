{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v2/messages/VehicleBusinessStateSnapshot.schema.json",
  "title": "VehicleBusinessStateSnapshot",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 2
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "1.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "VehicleBusinessStateSnapshot"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "vehicleBusinessStateRevision": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Revision"
        },
        "readiness": {
          "type": "string",
          "enum": [
            "READY",
            "RECOVERY_REQUIRED"
          ]
        },
        "activePurpose": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "TRANSPORT",
                "CHARGING",
                "CLEARING_MAINTENANCE",
                "IDLE_RETURN"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "manualChargingHold": {
          "type": "boolean"
        },
        "batteryState": {
          "type": "string",
          "enum": [
            "SUFFICIENT",
            "LOW",
            "UNKNOWN"
          ]
        },
        "blockingFacts": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/BlockingFact"
          },
          "uniqueItems": true
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
        }
      },
      "required": [
        "vehicleBusinessStateRevision",
        "readiness",
        "activePurpose",
        "manualChargingHold",
        "batteryState",
        "blockingFacts",
        "observedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
