{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v4/messages/ForcedMechanicalRecoveryResult.schema.json",
  "title": "ForcedMechanicalRecoveryResult",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 4
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "3.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "ForcedMechanicalRecoveryResult"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "exceptionRecoverySessionId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "recoveryActionId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "forcedRecoveryGeneration": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Generation"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "MECHANICALLY_ISOLATED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/SlotNo"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "x-sortedAscending": true
        },
        "operator": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/OperatorContext"
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
        },
        "electronicEmptyProven": {
          "type": "boolean",
          "const": false
        },
        "vehicleReadyProven": {
          "type": "boolean",
          "const": false
        },
        "demandId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "cargoHandoff": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "sublot": {
                  "type": "string",
                  "minLength": 1
                },
                "receiverName": {
                  "type": "string",
                  "minLength": 1
                },
                "handedOverAt": {
                  "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
                }
              },
              "required": [
                "sublot",
                "receiverName",
                "handedOverAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exceptionRecoverySessionId",
        "recoveryActionId",
        "forcedRecoveryGeneration",
        "outcome",
        "slots",
        "operator",
        "observedAt",
        "electronicEmptyProven",
        "vehicleReadyProven",
        "demandId",
        "cargoHandoff"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "outcome": {
            "const": "MECHANICALLY_ISOLATED"
          },
          "demandId": {
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "demandId"
        ]
      },
      "then": {
        "properties": {
          "cargoHandoff": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "cargoHandoff": {
            "type": "null"
          }
        }
      }
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
