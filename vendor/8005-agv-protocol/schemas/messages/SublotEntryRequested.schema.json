{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v4/messages/SublotEntryRequested.schema.json",
  "title": "SublotEntryRequested",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 4
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "3.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "SublotEntryRequested"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "operationSessionId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Id"
        },
        "stationId": {
          "type": "string",
          "minLength": 1
        },
        "worklistRevision": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v4/common/types.schema.json#/$defs/Revision"
        },
        "expectedSublots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "entryMethods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "const": [
            "SCANNER",
            "KEYBOARD"
          ]
        },
        "expiresOnRevisionChange": {
          "type": "boolean",
          "const": true,
          "description": "`true` means the entry request expires on a revision change, and a revision change is: the stop ended, the operation session or the station changed (a worklist for another operation session or station with a strictly higher revision), the worklist became empty (a worklist no older than the entry request with empty `items`), or the control server rejected the submission with `WORKLIST_REVISION_STALE`. A worklist revision advancing within the same operation session at the same station is not a revision change, and the entry request stays open."
        }
      },
      "required": [
        "operationSessionId",
        "stationId",
        "worklistRevision",
        "expectedSublots",
        "entryMethods",
        "expiresOnRevisionChange"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
