{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v7/messages/OperationResult.schema.json",
  "title": "OperationResult",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 7
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "6.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "OperationResult"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "demandId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Id"
        },
        "slotOperationAttemptId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Id"
        },
        "operationType": {
          "type": "string",
          "enum": [
            "LOAD",
            "UNLOAD"
          ]
        },
        "overallOutcome": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED",
            "UNKNOWN",
            "COMPLETED_REMAINING_SKIPPED"
          ]
        },
        "slotResults": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/SlotResult"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Instant"
        },
        "journalCheckpoint": {
          "type": "string",
          "minLength": 1
        },
        "resultContentSha256": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v7/common/types.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "demandId",
        "slotOperationAttemptId",
        "operationType",
        "overallOutcome",
        "slotResults",
        "observedAt",
        "journalCheckpoint",
        "resultContentSha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "overallOutcome": {
                "const": "COMPLETED_REMAINING_SKIPPED"
              }
            },
            "required": [
              "overallOutcome"
            ]
          },
          "then": {
            "properties": {
              "operationType": {
                "const": "LOAD"
              },
              "slotResults": {
                "items": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "COMPLETED",
                        "NOT_STARTED"
                      ]
                    },
                    "lockState": {
                      "const": "LOCKED"
                    },
                    "unlockOutputState": {
                      "const": "RESET"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "outcome": {
                            "const": "COMPLETED"
                          }
                        },
                        "required": [
                          "outcome"
                        ]
                      },
                      "then": {
                        "properties": {
                          "finalPhysicalState": {
                            "const": "OCCUPIED"
                          },
                          "reasonCodes": {
                            "not": {
                              "contains": {
                                "const": "REMAINING_BASKETS_SKIPPED"
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "outcome": {
                            "const": "NOT_STARTED"
                          }
                        },
                        "required": [
                          "outcome"
                        ]
                      },
                      "then": {
                        "properties": {
                          "finalPhysicalState": {
                            "const": "EMPTY"
                          },
                          "reasonCodes": {
                            "contains": {
                              "const": "REMAINING_BASKETS_SKIPPED"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "outcome": {
                          "const": "COMPLETED"
                        }
                      }
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "outcome": {
                          "const": "NOT_STARTED"
                        }
                      }
                    },
                    "minContains": 1
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "slotResults": {
                "items": {
                  "properties": {
                    "reasonCodes": {
                      "not": {
                        "contains": {
                          "const": "REMAINING_BASKETS_SKIPPED"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
