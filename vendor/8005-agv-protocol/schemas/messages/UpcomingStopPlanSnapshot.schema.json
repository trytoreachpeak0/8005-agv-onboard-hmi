{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v3/messages/UpcomingStopPlanSnapshot.schema.json",
  "title": "UpcomingStopPlanSnapshot",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 3
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "2.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "UpcomingStopPlanSnapshot"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "planRevision": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Revision"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "movementLegId": {
                "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
              },
              "legType": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "TO_PICKUP",
                      "TO_DROPOFF"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stopPurposeCategory": {
                "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/StopPurposeCategory"
              },
              "demandId": {
                "anyOf": [
                  {
                    "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publicStationFunction": {
                "anyOf": [
                  {
                    "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/PublicStationFunction"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "stationId": {
                "type": "string",
                "minLength": 1
              },
              "mapId": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "PLANNED",
                  "ACTIVE",
                  "ARRIVED",
                  "COMPLETED",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "movementLegId",
              "legType",
              "stopPurposeCategory",
              "demandId",
              "publicStationFunction",
              "sequence",
              "stationId",
              "mapId",
              "state"
            ],
            "additionalProperties": false
          },
          "maxItems": 9,
          "uniqueItems": true,
          "x-sortedBy": "sequence"
        }
      },
      "required": [
        "planRevision",
        "legs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
