{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v2/messages/RecoveryStateReport.schema.json",
  "title": "RecoveryStateReport",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 2
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "1.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "RecoveryStateReport"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "type": "null"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reportId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Id"
        },
        "observedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Instant"
        },
        "unsettledSlotOperationAttemptId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenRecoveryCheckpoint": {
          "type": "string",
          "enum": [
            "NONE",
            "PREPARED",
            "ACTIVE_UNLOCK_SET",
            "SAFE_FINISH_REACHED",
            "RESULT_RECORDED"
          ]
        },
        "activeUnlockSlots": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/SlotNo"
          },
          "maxItems": 8,
          "uniqueItems": true,
          "x-sortedAscending": true
        },
        "forcedRecoveryGeneration": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Generation"
        },
        "pendingResults": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/PendingResultRef"
          },
          "uniqueItems": true
        },
        "journalContentSha256": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v2/common/types.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "reportId",
        "observedAt",
        "unsettledSlotOperationAttemptId",
        "provenRecoveryCheckpoint",
        "activeUnlockSlots",
        "forcedRecoveryGeneration",
        "pendingResults",
        "journalContentSha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
