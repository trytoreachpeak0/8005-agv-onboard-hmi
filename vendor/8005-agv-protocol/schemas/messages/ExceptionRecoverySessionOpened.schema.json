{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/agv-full-product/v3/messages/ExceptionRecoverySessionOpened.schema.json",
  "title": "ExceptionRecoverySessionOpened",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 3
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "const": "AGV_FULL_PRODUCT"
    },
    "protocolReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": [
        "2.0.0"
      ]
    },
    "protocolReleaseManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Sha256"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "const": "ExceptionRecoverySessionOpened"
    },
    "messageId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
    },
    "correlationId": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
    },
    "agvId": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "AGV-8005-01"
      ]
    },
    "sessionGeneration": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Generation"
    },
    "sentAt": {
      "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Instant"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
        },
        "exceptionRecoverySessionId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
        },
        "openedAt": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Instant"
        },
        "eventId": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
        },
        "demandId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "slotOperationAttemptId": {
          "anyOf": [
            {
              "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/SlotNo"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "x-sortedAscending": true
        },
        "recoverySessionRevision": {
          "$ref": "https://schemas.8005-agv.local/agv-full-product/v3/common/types.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "requestId",
        "exceptionRecoverySessionId",
        "openedAt",
        "eventId",
        "demandId",
        "slotOperationAttemptId",
        "slots",
        "recoverySessionRevision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "protocolReleaseVersion",
    "protocolReleaseManifestSha256",
    "messageType",
    "messageId",
    "correlationId",
    "agvId",
    "sessionGeneration",
    "sentAt",
    "payload"
  ],
  "additionalProperties": false
}
